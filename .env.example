# Copy relevant lines into .env or .env.local for local development.
# .env and .env.local are both gitignored — never commit real values here.

# Toggles the "Download as PDF" button. When false (or unset), only
# "Download as Image" is available. Set true locally for full access.
# Goes in .env.
VITE_PRO_ENABLED=false

# Password for the /archive route (Saved Drafts + Uploaded PDFs). Only its
# SHA-256 hash is embedded in the built bundle (see vite.config.js) — the
# plaintext never ships to the client. Set locally in .env.local; in CI it
# comes from the ADMIN_PASSWORD repo secret instead (see
# .github/workflows/deploy.yml), never committed here.
VITE_ADMIN_PASSWORD=
